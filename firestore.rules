rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for zero-trust compliance
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document: private to the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User documents collection: isolated per authenticated user
    match /users/{userId}/documents/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User originality reports collection: isolated per authenticated user
    match /users/{userId}/reports/{reportId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
